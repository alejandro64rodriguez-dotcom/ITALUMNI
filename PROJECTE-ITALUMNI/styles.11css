/* ==========================================================
   ITALUMNI · DESIGN SYSTEM
   Tokens extracted from the Figma reference: magenta/purple
   gradient brand, pill-shaped buttons, dark navy sections
   alternating with light content sections.
   ========================================================== */

:root {
  /* --- Color --- */
  --color-primary: #ec008c;
  --color-primary-dark: #c2007a;
  --color-accent: #7c3aed;
  --gradient-primary: linear-gradient(135deg, #ec008c 0%, #7c3aed 100%);

  --color-navy: #14152b;
  --color-navy-soft: #1d1e3d;

  --color-bg: #ffffff;
  --color-bg-soft: #f7f7fb;

  --color-text: #1f2233;
  --color-text-muted: #6b6f84;
  --color-text-on-dark: #ffffff;
  --color-text-on-dark-muted: #a9abc4;

  --color-border: #e7e7f1;
  --color-star: #ffb400;

  /* --- Radius --- */
  --radius-pill: 999px;
  --radius-card: 18px;
  --radius-card-sm: 12px;

  /* --- Shadow --- */
  --shadow-card: 0 4px 20px rgba(20, 21, 43, 0.06);
  --shadow-card-hover: 0 10px 28px rgba(20, 21, 43, 0.12);

  /* --- Type --- */
  --font-base: 'Source Sans 3', -apple-system, BlinkMacSystemFont, sans-serif;
}

/* ---------- Reset ---------- */
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: var(--font-base);
  color: var(--color-text);
  background: var(--color-bg);
  -webkit-font-smoothing: antialiased;
}
img { max-width: 100%; display: block; }
a { text-decoration: none; color: inherit; }
button { font-family: inherit; }
h1, h2, h3, p { margin: 0; }
:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

/* ---------- Brand logo ---------- */
.brand {
  font-family: var(--font-base);
  font-weight: 800;
  font-size: 1.4rem;
  letter-spacing: 0.02em;
  color: var(--color-text);
}
.brand__mark {
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.brand--footer { color: var(--color-text-on-dark); }

/* ---------- Buttons ---------- */
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 26px;
  font-weight: 600;
  font-size: 0.95rem;
  border: 2px solid transparent;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
}
.button--pill { border-radius: var(--radius-pill); }
.button--block { width: 100%; }
.button--small { padding: 8px 18px; font-size: 0.85rem; }

.button--primary {
  background: var(--gradient-primary);
  color: var(--color-text-on-dark);
  border-color: transparent;
}
.button--primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 20px rgba(236, 0, 140, 0.35);
}

.button--outline {
  background: transparent;
  color: var(--color-primary);
  border-color: var(--color-primary);
}
.button--outline:hover {
  background: rgba(236, 0, 140, 0.08);
}

/* on dark backgrounds, outline needs light text/border */
.newsletter .button--primary,
.hero .button--outline {
  border-color: var(--color-primary);
}

/* ==========================================================
   HAMBURGER MENU (checkbox toggle — no JS needed)
   Shared pattern used by both the mobile app-header and the
   desktop navbar dropdown.
   ========================================================== */

/* The checkbox itself is invisible; its :checked state is what
   drives the dropdown open/closed via the CSS sibling selector (~) */
.menu-toggle-checkbox {
  position: absolute;
  opacity: 0;
  width: 1px;
  height: 1px;
  pointer-events: none;
}

.menu-btn {
  width: 32px;
  height: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 0;
  border: none;
  background: none;
  cursor: pointer;
}

.menu-btn span {
  display: block;
  width: 100%;
  height: 3px;
  background: var(--color-text);
  border-radius: 2px;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

/* Turn the three bars into an "X" while the menu is open */
.menu-toggle-checkbox:checked + .menu-btn span:nth-child(1) {
  transform: translateY(9px) rotate(45deg);
}
.menu-toggle-checkbox:checked + .menu-btn span:nth-child(2) {
  opacity: 0;
}
.menu-toggle-checkbox:checked + .menu-btn span:nth-child(3) {
  transform: translateY(-9px) rotate(-45deg);
}

/* ==========================================================
   MOBILE VIEW  (base styles = mobile-first)
   ========================================================== */

.l-mobile-view { display: block; }
.l-desktop-view { display: none; }

.l-app-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-soft);
  padding-bottom: 76px; /* leaves room for the fixed bottom nav */
}

.app-header {
  position: relative; /* anchors .mobile-dropdown below it */
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px 12px;
  background: var(--color-bg);
}
.app-header h1 {
  font-size: 1.1rem;
  font-weight: 700;
}
.icon-btn {
  border: none;
  background: none;
  font-size: 1.2rem;
  cursor: pointer;
  color: var(--color-text);
}
.avatar {
  display: block;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--gradient-primary);
}

/* Dropdown panel that slides open under the mobile header */
.mobile-dropdown {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  max-height: 0;
  overflow: hidden;
  background: var(--color-bg);
  border-bottom: 1px solid var(--color-border);
  box-shadow: var(--shadow-card);
  transition: max-height 0.25s ease;
  z-index: 30;
}
.mobile-dropdown a {
  padding: 14px 20px;
  font-weight: 600;
  font-size: 0.9rem;
  color: var(--color-text);
  border-bottom: 1px solid var(--color-border);
}
.mobile-dropdown a:last-child { border-bottom: none; }

.menu-toggle-checkbox:checked ~ .mobile-dropdown {
  max-height: 320px;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 20px 16px;
  padding: 10px 16px;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-pill);
}
.search-bar__icon { font-size: 0.95rem; color: var(--color-text-muted); }
.search-bar__input {
  border: none;
  outline: none;
  flex: 1;
  font-size: 0.9rem;
  font-family: inherit;
  background: transparent;
}

.l-app-content { flex: 1; padding: 0 20px; }

.l-card-grid {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.feature-card {
  background: var(--color-bg);
  border-radius: var(--radius-card);
  padding: 16px;
  box-shadow: var(--shadow-card);
}
.feature-card__image {
  height: 120px;
  border-radius: var(--radius-card-sm);
  margin-bottom: 12px;
  background: var(--gradient-primary);
  opacity: 0.15;
}
.feature-card__image--networking { background: linear-gradient(135deg, #ec008c, #ff8ac0); }
.feature-card__image--jobs { background: linear-gradient(135deg, #7c3aed, #a78bfa); }
.feature-card__title {
  font-size: 1rem;
  font-weight: 700;
  margin-bottom: 4px;
}
.feature-card__text {
  font-size: 0.85rem;
  color: var(--color-text-muted);
  margin-bottom: 14px;
}

.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  background: var(--color-bg);
  border-top: 1px solid var(--color-border);
  padding: 10px 8px calc(10px + env(safe-area-inset-bottom));
}
.bottom-nav__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  font-size: 0.65rem;
  color: var(--color-text-muted);
  flex: 1;
  text-align: center;
}
.bottom-nav__icon { font-size: 1.1rem; }
.bottom-nav__item.is-active {
  color: var(--color-primary);
  font-weight: 600;
}

/* ==========================================================
   DESKTOP VIEW
   ========================================================== */

/* 3-column layout: [ menu ] [ brand ] [ cta ]
   This is what fixes the crowding — instead of squeezing 3 links
   + 2 buttons into one row, only one button stays pinned right
   and the links live inside the dropdown on the left. */
.navbar {
  position: relative;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 20px 48px;
  border-bottom: 1px solid var(--color-border);
}

.navbar__menu {
  position: relative;
  justify-self: start;
}

.navbar__brand {
  justify-self: center;
}

.navbar__cta {
  justify-self: end;
}

/* Dropdown panel for the desktop hamburger */
.navbar__dropdown {
  position: absolute;
  top: calc(100% + 12px);
  left: 0;
  min-width: 240px;
  display: flex;
  flex-direction: column;
  padding: 8px;
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-card-sm);
  box-shadow: var(--shadow-card-hover);
  opacity: 0;
  transform: translateY(-6px);
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
  z-index: 30;
}

.navbar__dropdown .navbar__link {
  padding: 10px 14px;
  border-radius: 8px;
  border-bottom: none;
}
.navbar__dropdown .navbar__link.is-active,
.navbar__dropdown .navbar__link:hover {
  background: var(--color-bg-soft);
  color: var(--color-text);
  border-bottom-color: transparent;
}

#desktop-menu-toggle:checked ~ .navbar__dropdown {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.navbar__link {
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--color-text-muted);
  padding-bottom: 4px;
  border-bottom: 2px solid transparent;
}
.navbar__link.is-active,
.navbar__link:hover {
  color: var(--color-text);
}

/* ---------- Hero ---------- */
.hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 48px;
  padding: 72px 48px;
  max-width: 1280px;
  margin: 0 auto;
}
.hero__title {
  font-size: 3rem;
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 16px;
}
.hero__title-accent {
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.hero__text {
  font-size: 1.1rem;
  color: var(--color-text-muted);
  max-width: 440px;
  margin-bottom: 28px;
}
.hero__actions { display: flex; gap: 14px; }

.hero__media {
  position: relative;
}

.hero__image {
  position: relative;            /* Nuevo */
  aspect-ratio: 4 / 3;
  border-radius: var(--radius-card);
  overflow: hidden;              /* Nuevo: recorta la imagen */
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Nuevo */
.hero__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.hero__play-btn {
  position: absolute;            /* Nuevo */
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);

  width: 64px;
  height: 64px;
  border-radius: 50%;
  border: none;
  background: rgba(255,255,255,0.9);
  color: var(--color-primary);
  font-size: 1.3rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---------- Benefits ---------- */
.benefits {
  background: var(--color-bg-soft);
  padding: 64px 48px;
}
.benefits__title {
  text-align: center;
  font-size: 2rem;
  font-weight: 800;
  margin-bottom: 40px;
}
.l-benefits-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  max-width: 1120px;
  margin: 0 auto;
}
.benefit-card {
  background: var(--color-bg);
  border-radius: var(--radius-card);
  padding: 32px 24px;
  text-align: center;
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.benefit-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-card-hover);
}
.benefit-card__icon {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.6rem;
  margin-bottom: 18px;
}
.benefit-card__text {
  color: var(--color-text-muted);
  font-size: 0.92rem;
  margin-bottom: 20px;
  line-height: 1.5;
}

/* ---------- Testimonials ---------- */
.testimonials {
  padding: 64px 48px;
  max-width: 1120px;
  margin: 0 auto;
}
.testimonials__title {
  text-align: center;
  font-size: 1.6rem;
  font-weight: 700;
  max-width: 640px;
  margin: 0 auto 40px;
}
.l-testimonial-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.testimonial-card {
  background: var(--color-bg-soft);
  border-radius: var(--radius-card);
  padding: 24px;
}
.testimonial-card__person {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}
.testimonial-card__avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--gradient-primary);
  flex-shrink: 0;
}
.testimonial-card__name { font-weight: 700; font-size: 0.95rem; }
.testimonial-card__stars { color: var(--color-star); font-size: 0.8rem; }
.testimonial-card__quote {
  font-size: 0.9rem;
  color: var(--color-text-muted);
  line-height: 1.55;
  font-style: italic;
}

.testimonials__nav {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-top: 32px;
}
.testimonials__nav-button {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid var(--color-border);
  background: var(--color-bg);
  cursor: pointer;
  font-size: 1.1rem;
  color: var(--color-text);
}
.testimonials__nav-button:hover {
  background: var(--color-primary);
  color: var(--color-text-on-dark);
  border-color: var(--color-primary);
}

/* ---------- Newsletter (dark section) ---------- */
.newsletter {
  background: var(--color-navy);
  color: var(--color-text-on-dark);
  padding: 56px 48px;
  text-align: center;
}
.newsletter__title {
  font-size: 1.4rem;
  font-weight: 700;
  margin-bottom: 24px;
}
.newsletter__form {
  display: flex;
  justify-content: center;
  gap: 12px;
  max-width: 480px;
  margin: 0 auto;
}
.newsletter__input {
  flex: 1;
  padding: 12px 18px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--color-navy-soft);
  background: var(--color-navy-soft);
  color: var(--color-text-on-dark);
  font-family: inherit;
  font-size: 0.9rem;
}
.newsletter__input::placeholder { color: var(--color-text-on-dark-muted); }
.newsletter__input:focus { outline: 2px solid var(--color-primary); }

/* ---------- Footer ---------- */
.site-footer {
  background: var(--color-navy);
  color: var(--color-text-on-dark-muted);
  padding: 40px 48px 24px;
}
.site-footer__main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 20px;
  max-width: 1120px;
  margin: 0 auto 24px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--color-navy-soft);
}
.site-footer__links {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  font-size: 0.85rem;
}
.site-footer__links a:hover { color: var(--color-text-on-dark); }

.site-footer__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  max-width: 1120px;
  margin: 0 auto;
  font-size: 0.8rem;
}
.site-footer__bottom select {
  background: var(--color-navy-soft);
  color: var(--color-text-on-dark);
  border: none;
  border-radius: var(--radius-pill);
  padding: 6px 14px;
  font-family: inherit;
  font-size: 0.8rem;
}
.site-footer__socials { display: flex; gap: 12px; }
.site-footer__socials a {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--color-navy-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  color: var(--color-text-on-dark);
}
.site-footer__socials a:hover { background: var(--color-primary); }

/* ==========================================================
   RESPONSIVE — mobile-first, 2 breakpoints
   ========================================================== */

/* Footer / bottom-nav swap for content pages (Xarxa, Oportunitats, etc.)
   that don't use the .l-mobile-view / .l-desktop-view split like home.html.
   Mobile-first: bottom-nav shows, site-footer stays hidden until desktop. */
.site-footer { display: none; }
.bottom-nav { display: flex; }

/* Leaves room so page content isn't hidden behind the fixed bottom-nav
   on mobile. Add this class to the <main> of any content page. */
.l-content-page { padding-bottom: 96px; }

@media (min-width: 768px) {
  .site-footer { display: block; }
  .bottom-nav { display: none; }
  .l-content-page { padding-bottom: 28px; }
}

/* Breakpoint 1: tablet / small desktop */
@media (min-width: 768px) {
  .l-mobile-view { display: none; }
  .l-desktop-view { display: block; }

  .hero { grid-template-columns: 1fr; text-align: center; padding: 56px 32px; }
  .hero__text { margin-left: auto; margin-right: auto; }
  .hero__actions { justify-content: center; }
  .l-benefits-grid { grid-template-columns: repeat(2, 1fr); }
  .l-testimonial-grid { grid-template-columns: repeat(2, 1fr); }
}

/* Breakpoint 2: full desktop */
@media (min-width: 1024px) {
  .hero { grid-template-columns: 1fr 1fr; text-align: left; padding: 80px 48px; }
  .hero__text { margin-left: 0; margin-right: 0; }
  .hero__actions { justify-content: flex-start; }
  .l-benefits-grid { grid-template-columns: repeat(3, 1fr); }
  .l-testimonial-grid { grid-template-columns: repeat(3, 1fr); }
}

/* ---------- Signup form ---------- */
/* ====== PÁGINA SIGNUP ====== */

body[data-page="signup"] {
  margin: 0;
  min-height: 100vh;

  background:
    linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.35)),
    url("images/image2.jpg");

  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

/* Mantiene el navbar encima de la imagen */
body[data-page="signup"] .navbar{
  position: relative;
  z-index: 10;
}

/* Centra el formulario */
.signup {
  min-height: calc(100vh - 80px);
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40px 20px;
}

/* Tarjeta blanca */
.signup__card {
  width: 100%;
  max-width: 480px;

  background: #fff;
  border-radius: 20px;
  padding: 35px;

  box-shadow: 0 15px 40px rgba(0,0,0,.25);
}

/* Títulos */
.signup__card h1{
  margin: 0 0 10px;
  text-align: center;
}

.signup__card p{
  text-align: center;
  margin-bottom: 25px;
  color: var(--color-text-muted);
}

/* Campos */
.form-field{
  display:flex;
  flex-direction:column;
  gap:8px;
  margin-bottom:16px;
}

.form-field label{
  font-weight:600;
}

.form-field input[type="text"],
.form-field input[type="email"],
.form-field textarea,
.form-field select{
  width:100%;
  padding:12px 15px;
  border:1px solid #ddd;
  border-radius:8px;
  font-size:16px;
  box-sizing:border-box;
  font-family:inherit;
}

/* Checkbox */
.form-field input[type="checkbox"]{
  margin-right:8px;
}

/* Botones */
.form-actions{
  display:flex;
  justify-content:space-between;
  margin-top:20px;
}

.toast{
  position:fixed;
  right:20px;
  bottom:20px;
  background:var(--color-navy);
  color:#fff;
  padding:12px 16px;
  border-radius:12px;
  box-shadow:var(--shadow-card);
  display:none;
}

.toast.is-visible{
  display:block;
}